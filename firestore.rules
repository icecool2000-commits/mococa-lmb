rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['icecool2000@gmail.com']
        && request.auth.token.email_verified == true;
    }
    // editor: login de usuário e senha criado pelo organizador (coleção editores)
    function isEditor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/editores/$(request.auth.uid));
    }
    function podeTorneio() { return isAdmin() || isEditor(); }
    // gestor: editor com papel 'gestor' (cria e remove acessos de editor/mesário)
    function isGestor() {
      return isEditor()
        && get(/databases/$(database)/documents/editores/$(request.auth.uid)).data.get('papel', 'editor') == 'gestor';
    }
    function presencaValida(dia) {
      return request.auth != null
        && dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['nome', 'em', 'uid'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 40
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.em == request.time;
    }
    function presencaAmistoso() {
      return request.auth != null
        && request.resource.data.keys().hasOnly(['nome', 'em', 'uid'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 40
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.em == request.time;
    }
    function amistosoAberto(id) {
      return request.time < get(/databases/$(database)/documents/basquete_amistosos/$(id)).data.inicio;
    }
    function dataDo(dia) {
      let p = dia.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }
    // A lista fica aberta do início do treino anterior até o início deste treino.
    // Horários em UTC (Brasília = UTC-3): 19:00 = 22h UTC, 10:00 = 13h UTC.
    function biribolAberto(dia) {
      let d = dataDo(dia);
      let w = d.dayOfWeek(); // 1 = segunda ... 7 = domingo
      let ini = d + duration.value(w == 7 ? 13 : 22, 'h');
      let abre = w == 2 ? 57 : (w == 4 ? 48 : 63);
      return (w == 2 || w == 4 || w == 7)
        && request.time < ini
        && request.time >= ini - duration.value(abre, 'h');
    }
    function basqueteAberto(dia) {
      let d = dataDo(dia);
      let ini = d + duration.value(13, 'h');
      return d.dayOfWeek() == 7
        && request.time < ini
        && request.time >= ini - duration.value(168, 'h');
    }

    // ===== BIRIBOL =====
    match /{path=**}/presencas/{p} { allow read: if true; }
    match /treinos/{dia} {
      allow read: if true;
      allow write: if isAdmin();
      match /presencas/{p} {
        allow create: if isAdmin() || (presencaValida(dia) && biribolAberto(dia));
        allow delete: if isAdmin()
          || (request.auth != null && resource.data.uid == request.auth.uid && biribolAberto(dia));
        allow update: if isAdmin();
      }
    }
    match /config/{d} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== BASQUETE =====
    match /{path=**}/basquete_presencas/{p} { allow read: if true; }
    match /basquete_treinos/{dia} {
      allow read: if true;
      allow write: if isAdmin();
      match /basquete_presencas/{p} {
        allow create: if isAdmin() || (presencaValida(dia) && basqueteAberto(dia));
        allow delete: if isAdmin()
          || (request.auth != null && resource.data.uid == request.auth.uid && basqueteAberto(dia));
        allow update: if isAdmin();
      }
    }
    // Jogos amistosos: o organizador cria a lista com data, hora, local e adversário (inicio = timestamp do jogo).
    // Qualquer pessoa confirma até o horário do jogo; depois só o organizador corrige.
    match /basquete_amistosos/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /basquete_presencas/{p} {
        allow create: if isAdmin() || (presencaAmistoso() && amistosoAberto(id));
        allow delete: if isAdmin()
          || (request.auth != null && resource.data.uid == request.auth.uid && amistosoAberto(id));
        allow update: if isAdmin();
      }
    }
    match /basquete_config/{d} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== BASQUETE AEM (mesmas regras do Basquete, coleções aem_*) =====
    // Dias e horários dos treinos ficam em aem_config/agenda (organizador e editores mudam pelo app):
    // mins = {"0": 600} minutos do dia em Brasília por dia da semana (0 = domingo); abre = minutos que a lista fica aberta antes do treino.
    // Sem agenda cadastrada vale o horário antigo (domingo 10:00).
    function aemAgendaExiste() {
      return exists(/databases/$(database)/documents/aem_config/agenda);
    }
    function aemAberto(dia) {
      let ag = get(/databases/$(database)/documents/aem_config/agenda).data;
      let d = dataDo(dia);
      let k = string(d.dayOfWeek() % 7);
      let m = ag.mins.get(k, -1);
      let ini = d + duration.value(m + 180, 'm');
      return m >= 0
        && request.time < ini
        && request.time >= ini - duration.value(ag.abre.get(k, 10080), 'm');
    }
    function aemTreinoAberto(dia) {
      return (aemAgendaExiste() && aemAberto(dia)) || (!aemAgendaExiste() && basqueteAberto(dia));
    }
    match /aem_config/agenda {
      allow read: if true;
      allow write: if podeTorneio()
        && request.resource.data.keys().hasOnly(['mins', 'abre', 'locais', 'atualizado', 'por'])
        && request.resource.data.mins is map
        && request.resource.data.mins.size() >= 1
        && request.resource.data.mins.size() <= 7
        && request.resource.data.abre is map
        && request.resource.data.locais is map;
    }
    match /{path=**}/aem_presencas/{p} { allow read: if true; }
    match /aem_treinos/{dia} {
      allow read: if true;
      allow write: if isAdmin();
      match /aem_presencas/{p} {
        allow create: if isAdmin() || (presencaValida(dia) && aemTreinoAberto(dia));
        allow delete: if isAdmin()
          || (request.auth != null && resource.data.uid == request.auth.uid && aemTreinoAberto(dia));
        allow update: if isAdmin();
      }
    }
    match /aem_amistosos/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /aem_presencas/{p} {
        allow create: if isAdmin() || (presencaAmistoso() && request.time < get(/databases/$(database)/documents/aem_amistosos/$(id)).data.inicio);
        allow delete: if isAdmin()
          || (request.auth != null && resource.data.uid == request.auth.uid && request.time < get(/databases/$(database)/documents/aem_amistosos/$(id)).data.inicio);
        allow update: if isAdmin();
      }
    }
    match /aem_config/{d} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /aem_torneios/{t} {
      allow read: if true;
      allow write: if podeTorneio();
      match /jogos/{j} {
        allow read: if true;
        allow write: if podeTorneio();
      }
    }

    // ===== EDITORES =====
    // organizador cria/remove/promove qualquer um; gestor só cria e remove editores/mesários (nunca gestores)
    match /editores/{u} {
      allow read: if isAdmin() || isGestor() || (request.auth != null && request.auth.uid == u);
      allow create: if isAdmin()
        || (isGestor() && request.resource.data.get('papel', 'editor') == 'editor');
      allow delete: if isAdmin()
        || (isGestor() && resource.data.get('papel', 'editor') != 'gestor');
      allow update: if isAdmin();
    }

    // ===== TORNEIOS (Biribol e Basquete) =====
    match /biribol_torneios/{t} {
      allow read: if true;
      allow write: if podeTorneio();
      match /jogos/{j} {
        allow read: if true;
        allow write: if podeTorneio();
      }
    }
    match /lmb_torneios/{t} {
      allow read: if true;
      allow write: if podeTorneio();
      match /jogos/{j} {
        allow read: if true;
        allow write: if podeTorneio();
      }
    }
    match /basquete_torneios/{t} {
      allow read: if true;
      allow write: if podeTorneio();
      match /jogos/{j} {
        allow read: if true;
        allow write: if podeTorneio();
      }
    }

    // ===== MÍDIAS (fotos e vídeos dos torneios, em pedaços) e perfis do Instagram =====
    match /midia_config/{app} {
      allow read: if true;
      allow write: if podeTorneio();
    }
    match /{col}/{id} {
      allow read: if col.matches('midias_[a-z]+');
      allow write: if col.matches('midias_[a-z]+') && podeTorneio();
      match /partes/{p} {
        allow read: if col.matches('midias_[a-z]+');
        allow delete: if col.matches('midias_[a-z]+') && podeTorneio();
        allow create, update: if col.matches('midias_[a-z]+') && podeTorneio()
          && request.resource.data.d is string && request.resource.data.d.size() <= 1000000;
      }
    }

    // ===== AO VIVO (transmissão do YouTube/Instagram + jogo em destaque; histórico) =====
    match /ao_vivo/{app} {
      allow read: if true;
      allow write: if podeTorneio();
      match /historico/{h} {
        allow read: if true;
        allow write: if podeTorneio();
      }
    }

    // ===== MOCOCA NA LIGA (app do time) =====
    match /mococa_torneios/{t} {
      allow read: if true;
      allow write: if podeTorneio();
      match /jogos/{j} {
        allow read: if true;
        allow write: if podeTorneio();
      }
    }
    match /mococa_atletas/{a} {
      allow read: if true;
      allow write: if podeTorneio();
    }
    match /mococa_etapas/{e} {
      allow read: if true;
      allow write: if podeTorneio();
      // lista de confirmação da próxima etapa: qualquer pessoa confirma o próprio nome
      match /confirmacoes/{c} {
        allow read: if true;
        allow create: if podeTorneio() || (
          request.auth != null
          && request.resource.data.keys().hasOnly(['nome', 'aid', 'uid', 'em'])
          && request.resource.data.nome is string
          && request.resource.data.nome.size() >= 2
          && request.resource.data.nome.size() <= 40
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.em == request.time
          && get(/databases/$(database)/documents/mococa_etapas/$(e)).data.status == 'proxima');
        allow delete: if podeTorneio()
          || (request.auth != null && resource.data.uid == request.auth.uid
              && get(/databases/$(database)/documents/mococa_etapas/$(e)).data.status == 'proxima');
      }
    }
  }
}
